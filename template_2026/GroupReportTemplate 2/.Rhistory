# paste(" - Le", ordres[ordre[4]], "paramètre, nommé typevar2, n'a aucune valeur par défaut. Il prend les valeurs 'numeric' ou 'factor' et indique la classe de var2.\n"),
# paste(" - Le", ordres[ordre[5]], "paramètre, nommé titre, a une valeur par défaut que vous choisirez. \n")
)
cat(chaines[order(ordre)[1]])
cat(chaines[order(ordre)[2]])
cat(chaines[order(ordre)[3]])
#cat(chaines[order(ordre)[4]])
#cat(chaines[order(ordre)[5]])
cat("\n\n")
var1 <- sample(c("quantitative", "qualitative"), 1)
#var2 <- sample(c("quantitative", "qualitative"), 1)
#var1 <- setdiff(c("quantitative", "qualitative nominale", "qualitative ordinale"), var1)[1]
var2 <- if (var1 == "quantitative") "qualitative" else sample(c("quantitative", "qualitative"), 1)
cat(paste0("Votre fonction doit renvoyer la valeur de l'indicateur numérique approprié (au choix entre la distance du chi2, le coefficient de corrélation linéaire ou la dispersion (ou variance) inter) mesurant la liaison entre les deux variables sélectionnées dans le tableau 'X', lorsque les types de ces variables sont ", var1, "/", var2, ". Votre programme tracera aussi le graphique approprié pour ces deux variables à l'aide de ggplot2 (tel que présenté dans les slides du cours), mais uniquement si la valeur du paramètre formel 'tracer' est mise à 'TRUE' (sans les guillemets). Veuillez à fournir un graphique bien structuré (titre pour les axes, légende si besoin, etc)."))
cat("\n\n")
cat("\n\n\n")
cat(paste("QUESTION 2 :", "Importer dans R les deux fichiers de données intima_media1-2025.csv et intima_media2-2025.txt puis afficher les 4 premières lignes de chacun des jeux de données. Remarquez que ces fichiers contiennent certaines valeurs manquantes."))
cat("\n\n\n")
cat(paste("QUESTION 3 :", "Sur combien d'individus le fichier intima_media1-2025.csv contient-t-il des informations ? Et intima_media2-2025.txt ?
"))
cat("\n\n\n")
cat(paste("QUESTION 4 :", "Fusionner les deux jeux de données en un `data.frame` nommé `intima_media`."))
cat("\n\n\n")
cat(paste("QUESTION 5 :", "Préciser quelle est la nature statistique de chaque variable du jeu de données."))
cat("\n\n\n")
cat(paste("QUESTION 6 :", "À partir de vos réponses à la question précédente, indiquer à R quel est la nature des variables. N’oubliez pas en particulier d’utiliser la fonction levels pour indiquer à R à quoi correspondent les valeurs prises par les variables SEXE, tabac, SPORT et alcool."))
